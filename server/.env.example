# Banco de dados e autenticação
DATABASE_URL=postgres://usuario:senha@localhost:5432/meu_pwa
PORT=3001
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# URL pública do frontend (usada nos redirecionamentos do Stripe).
# Na Vercel, se omitida, usamos automaticamente o domínio do projeto.
APP_URL=http://localhost:5173

# Migrações automáticas na inicialização (ou no primeiro acesso na Vercel).
MIGRATE_ON_START=true

# Opcional: limite de conexões do pool. Na Vercel o padrão é 3.
# PG_POOL_MAX=10

# Opcional: confie no proxy da hospedagem (Railway, Render, Nginx etc.).
# Na Vercel isto é ativado automaticamente.
# TRUST_PROXY=true

# Opcional: liberar CORS para outra origem além da APP_URL.
# CORS_ORIGIN=https://outro-dominio.com

# Stripe (modo de teste)
STRIPE_SECRET_KEY=sk_test_coloque_sua_chave_aqui
STRIPE_WEBHOOK_SECRET=whsec_coloque_seu_segredo_aqui
# IDs dos preços criados no dashboard do Stripe para o plano Pro
STRIPE_PRICE_PRO_MONTHLY=price_id_do_plano_mensal
STRIPE_PRICE_PRO_YEARLY=price_id_do_plano_anual
